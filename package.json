{
  "name": "galaxy-clipper",
  "version": "0.1.0",
  "private": true,
  "description": "Independent AI assisted video clipping desktop client.",
  "license": "AGPL-3.0-only",
  "author": "bhwa233",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "pnpm engine:dev && pnpm processing:build && vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "processing:build": "vite build --config vite.processing.config.ts",
    "build": "pnpm typecheck && vite build && pnpm processing:build",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "engine:dev": "node scripts/prepare-engine.mjs",
    "engine:build": "node scripts/prepare-engine.mjs --bundle",
    "package": "pnpm engine:build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "i18next": "^26.4.2",
    "opencc-js": "^1.4.2",
    "react-intersection-observer": "11.0.1",
    "sherpa-onnx-node": "1.13.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.15",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.0.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.8.0"
}
